{
  "name": "ENG4701",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "npm run test:unit && npm run test:components",
    "test:components": "vitest run",
    "test:e2e:llvm": "npm run test:e2e:llvm:success && npm run test:e2e:llvm:failure",
    "test:e2e:llvm:failure": "node --experimental-strip-types scripts/run-llvm-failure-cases.mjs",
    "test:e2e:llvm:success": "node --experimental-strip-types scripts/run-llvm-real-cases.mjs",
    "test:unit": "node --test src/app/_helpers/*.test.mjs src/app/compiler-optimisation/_lib/*.test.mjs src/app/program-reduction/_lib/*.test.mjs src/server/api/llvm-service-client.test.mjs llvm-service/optimisation-payload.test.js llvm-service/measured-metrics.test.js",
    "test:optimisation-schema": "node --experimental-strip-types --test src/app/compiler-optimisation/_lib/optimisation-schema.test.mjs",
    "test:optimisation-adapter": "node --experimental-strip-types --test src/app/compiler-optimisation/_lib/optimisation-adapter.test.mjs",
    "test:optimisation-diff": "node --experimental-strip-types --test src/app/_helpers/text-diff.test.mjs",
    "test:pass-detail-display": "node --experimental-strip-types --test src/app/compiler-optimisation/_lib/pass-detail-display.test.mjs",
    "test:program-reduction": "node --experimental-strip-types --test src/app/program-reduction/_lib/reduction-trace-adapter.test.mjs",
    "test:real-backend-payload": "node --experimental-strip-types --test src/app/compiler-optimisation/_lib/real-backend-payload.test.mjs",
    "test:workspace-state": "node --experimental-strip-types --test src/app/compiler-optimisation/_lib/workspace-state.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.6"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.11.0"
}
